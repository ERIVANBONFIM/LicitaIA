<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- "Entrar com ChatGPT": serviço curto em primeiro plano enquanto o navegador (Custom Tab) está aberto,
         para o servidor de retorno em 127.0.0.1 continuar de pé. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Android 11+: permite achar um navegador com suporte a Custom Tabs. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application>
        <service
            android:name="com.licitaia.core.ai.ChatGptLoginService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
