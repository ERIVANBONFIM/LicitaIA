<?xml version="1.0" encoding="utf-8"?>
<!-- Somente HTTPS. Certificate pinning por portal/provedor deve ser adicionado aqui
     (<pin-set>) quando as integrações reais forem validadas. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
