<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Compartilhamento dos PDFs de proposta gravados em filesDir/proposals/ -->
        <provider
            android:name="com.licitaia.feature.tender.pdf.ProposalFileProvider"
            android:authorities="${applicationId}.licitaia.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/licitaia_proposal_paths" />
        </provider>
    </application>

</manifest>
